# Copie para .env para desenvolvimento local. Na Netlify, defina estas variáveis em
# Site configuration → Environment variables (nunca as publique no código).

# URL pública (canonical, Open Graph, sitemap). O valor de produção está em .env.production.
PUBLIC_SITE_URL=

# Base de dados. Local: ficheiro SQLite. Produção: Turso (libsql://...turso.io + token).
DATABASE_URL=file:data/moldea.db
DATABASE_AUTH_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys). Use as chaves de TESTE (sk_test_...) até validar tudo.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...), criado em Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=

# Só para testes automáticos locais: simula a Stripe. Recusado em produção.
PAYMENTS_FAKE=false
