---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, getDictionary, homePath } from '../i18n';

const locale = defaultLocale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} title={t.meta.notFoundTitle} description={t.notFound.text} noindex>
  <Header locale={locale} />
  <main id="conteudo" class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.text}</p>
      <a class="btn btn--primary" href={homePath(locale)}>{t.notFound.cta}</a>
    </div>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--section-space);
  }

  .not-found__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    background: repeating-linear-gradient(0deg, var(--blue) 0 9px, var(--orange) 9px 11px);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .not-found h1 {
    font-size: var(--step-3);
  }

  .not-found p:not(.not-found__code) {
    color: var(--ink-soft);
  }
</style>
