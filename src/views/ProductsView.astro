---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { getDictionary, locales, productsPath, type Locale } from '../i18n';
import type { Storefront } from '../server/storefront';

interface Props {
  locale: Locale;
  store: Storefront;
}

const { locale, store } = Astro.props;
const t = getDictionary(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, productsPath(l)]));
---

<BaseLayout locale={locale} title={t.meta.productsTitle} description={t.meta.productsDescription} alternates={alternates}>
  <Header locale={locale} alternates={alternates} selling={store.selling} current="products" />
  <main id="conteudo">
    <ProductCatalog locale={locale} products={store.products} selling={store.selling} variant="page" />
  </main>
  <Footer locale={locale} legal={store.settings.legal} />
  {store.selling && <CartDrawer locale={locale} settings={store.settings} />}
</BaseLayout>
