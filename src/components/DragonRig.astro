---
// Dragão articulado, montado com as peças de assets-originais/dragao-pecas.png
// (geradas por scripts/prepare-dragon.mjs). Estados por classe no elemento [data-dragon-rig]:
// (nenhuma) = parado · is-walking = a andar · is-looking = a olhar à volta · is-jumping = a saltar.
// Só a cabeça e os pés têm movimento próprio; braços, cauda e corpo ficam fixos (colados).
// Está virado para a esquerda; para a direita, espelhar o elemento (scale: -1 1).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import cabeca from '../assets/brand/dragon/cabeca.png';
import corpo from '../assets/brand/dragon/corpo-sem-pes.png';
import cauda from '../assets/brand/dragon/cauda.png';
import maoEsq from '../assets/brand/dragon/mao-esq.png';
import maoDir from '../assets/brand/dragon/mao-dir.png';
import peEsq from '../assets/brand/dragon/pe-esq-frente.png';
import peDir from '../assets/brand/dragon/pe-dir-frente.png';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// Montagem no espaço do corpo (514x476 px): posição do canto superior esquerdo e escala de cada peça.
// Caixa total: x de -40 a 790, y de -335 a 477 (830 x 812).
const BOX = { x: -40, y: -335, w: 830, h: 812 };
interface Part {
  src: ImageMetadata;
  x: number;
  y: number;
  scale: number;
  cls: string;
}
const place = ({ src, x, y, scale }: Part) => {
  const w = src.width * scale;
  return `left:${(((x - BOX.x) / BOX.w) * 100).toFixed(3)}%;top:${(((y - BOX.y) / BOX.h) * 100).toFixed(3)}%;width:${((w / BOX.w) * 100).toFixed(3)}%`;
};
const feet: Part[] = [
  { src: peDir, x: 294, y: 320, scale: 0.85, cls: 'rig__foot rig__foot--back' },
  { src: peEsq, x: -27, y: 320, scale: 0.85, cls: 'rig__foot rig__foot--front' },
];
const upper: Part[] = [
  { src: cauda, x: 380, y: 40, scale: 1, cls: 'rig__tail' },
  { src: corpo, x: 0, y: 0, scale: 1, cls: 'rig__body' },
  { src: maoDir, x: 300, y: 95, scale: 0.75, cls: 'rig__hand rig__hand--back' },
  { src: cabeca, x: -40, y: -335, scale: 0.8, cls: 'rig__head' },
  { src: maoEsq, x: 30, y: 110, scale: 0.75, cls: 'rig__hand rig__hand--front' },
];
// Largura de renderização: o dragão aparece com até ~300 px; densidade 2x para ecrãs nítidos.
const px = (p: Part) => Math.round(p.src.width * p.scale * 0.36);
---

<div class:list={['rig', className]} data-dragon-rig aria-hidden="true">
  <span class="rig__shadow"></span>
  <div class="rig__all">
    <div class="rig__upper">
      {upper.map((p) => <Image src={p.src} alt="" width={px(p)} densities={[1, 2]} class={p.cls} style={place(p)} loading="eager" />)}
    </div>
    {feet.map((p) => <Image src={p.src} alt="" width={px(p)} densities={[1, 2]} class={p.cls} style={place(p)} loading="eager" />)}
  </div>
</div>

<style>
  .rig {
    position: relative;
    width: 100%;
    aspect-ratio: 830 / 812;
  }

  .rig__all,
  .rig__upper {
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
  }

  .rig :global(img) {
    position: absolute;
    height: auto;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .rig__shadow {
    position: absolute;
    left: 6%;
    right: 26%;
    bottom: -1.5%;
    height: 5%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.22), transparent);
  }

  /* Articulações (origem de rotação, em % de cada peça). */
  .rig :global(.rig__head) {
    transform-origin: 50% 91%;
  }
  .rig :global(.rig__tail) {
    transform-origin: 6% 72%;
  }
  .rig :global(.rig__hand--front) {
    transform-origin: 60% 8%;
  }
  .rig :global(.rig__hand--back) {
    transform-origin: 45% 8%;
  }
  .rig :global(.rig__foot--front) {
    transform-origin: 55% 15%;
  }
  .rig :global(.rig__foot--back) {
    transform-origin: 45% 15%;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* ---- Parado: só a cabeça (inclina, olha, acena que sim) ---- */
    .rig :global(.rig__head) {
      animation: rg-head-idle 7s ease-in-out infinite;
    }

    /* ---- A andar: passos curtos alternados; o corpo não inclina (sem juntas visíveis) ---- */
    .rig.is-walking .rig__all {
      animation: rg-bounce 0.3s ease-in-out infinite alternate;
    }
    .rig.is-walking :global(.rig__foot--front) {
      animation: rg-step 0.6s ease-in-out infinite;
    }
    .rig.is-walking :global(.rig__foot--back) {
      animation: rg-step 0.6s ease-in-out infinite;
      animation-delay: -0.3s;
    }
    .rig.is-walking :global(.rig__head) {
      animation: rg-head-walk 0.3s ease-in-out infinite alternate;
    }
    .rig.is-walking .rig__shadow {
      animation: rg-shadow 0.3s ease-in-out infinite alternate;
    }

    /* ---- A olhar à volta ---- */
    .rig.is-looking :global(.rig__head) {
      animation: rg-look 2.2s ease-in-out;
    }

    /* ---- A saltar (o dragão inteiro; só a cabeça acompanha) ---- */
    .rig.is-jumping .rig__all {
      animation: rg-jump 0.8s ease-in-out;
    }
    .rig.is-jumping .rig__shadow {
      animation: rg-jump-shadow 0.8s ease-in-out;
    }
    .rig.is-jumping :global(.rig__head) {
      animation: rg-head-jump 0.8s ease-in-out;
    }
  }

  /* Cabeça parada: inclina, olha para cima, acena que sim duas vezes, volta. */
  @keyframes rg-head-idle {
    0%, 6% { transform: none; }
    14%, 24% { transform: rotate(-7deg); }
    32%, 40% { transform: rotate(6deg) translateY(-1.5%); }
    47% { transform: none; }
    52% { transform: rotate(2deg) translateY(2.5%); }
    57% { transform: rotate(-1deg); }
    62% { transform: rotate(2deg) translateY(2.5%); }
    68% { transform: none; }
    80%, 88% { transform: rotate(-3deg) translateX(-1.5%); }
    100% { transform: none; }
  }

  @keyframes rg-step {
    0% { transform: translateX(5%); }
    20% { transform: translate(2%, -13%) rotate(-5deg); }
    40% { transform: translate(-5%, -4%); }
    50% { transform: translateX(-5%); }
    100% { transform: translateX(5%); }
  }
  @keyframes rg-bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-1.6%); }
  }
  /* Cabeça acompanha o passo: balança e sobe/desce. */
  @keyframes rg-head-walk {
    from { transform: rotate(-4deg) translateY(0.8%); }
    to { transform: rotate(4deg) translateY(-1%); }
  }
  @keyframes rg-shadow {
    from { transform: scaleX(1); }
    to { transform: scaleX(0.92); }
  }
  @keyframes rg-look {
    0%, 100% { transform: none; }
    20%, 38% { transform: rotate(-9deg) translateX(-2%); }
    58%, 76% { transform: rotate(8deg) translateX(2%); }
  }
  @keyframes rg-head-jump {
    30% { transform: rotate(4deg) translateY(2%); }
    50% { transform: rotate(-5deg) translateY(-2%); }
  }
  @keyframes rg-jump {
    0%, 100% { transform: none; }
    18% { transform: translateY(1.5%) scale(1.07, 0.9); }
    45% { transform: translateY(-22%) scale(0.95, 1.07); }
    60% { transform: translateY(-24%); }
    82% { transform: translateY(1%) scale(1.06, 0.93); }
  }
  @keyframes rg-jump-shadow {
    45%, 60% { transform: scaleX(0.6); opacity: 0.4; }
  }
</style>
