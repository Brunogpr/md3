---
import Icon from './Icon.astro';
import ProductImage from './ProductImage.astro';
import AddToCart from './AddToCart.astro';
import { getDictionary, localeSettings, productPath, quotePath, type Locale } from '../i18n';
import { sectionIds } from '../config/site';
import { formatPrice } from '../lib/cart';
import { isAvailable, type PublicProduct } from '../server/products';

interface Props {
  locale: Locale;
  product: PublicProduct;
  selling: boolean;
}

const { locale, product, selling } = Astro.props;
const t = getDictionary(locale);
const image = product.images[0];
---

<section class="section featured" id={sectionIds.featured} aria-labelledby="featured-title">
  <div class="container featured__panel reveal">
    <figure class="featured__media tilt">
      {image && <ProductImage image={image} sizes="(max-width: 899px) 92vw, 520px" />}
    </figure>

    <div class="featured__content">
      <p class="eyebrow">{t.featured.eyebrow}</p>
      <h2 id="featured-title" class="split-words">{t.featured.title}</h2>
      <p class="featured__lead">{t.featured.text}</p>

      <div class="featured__product">
        <h3>{product.name}</h3>
        <p>{product.description || product.short}</p>
        {product.priceCents !== null && (
          <p class="featured__price">
            <span class="price">{formatPrice(product.priceCents, localeSettings[locale].intl)}</span>
            <span class="price__note">{t.store.vatIncluded}</span>
          </p>
        )}
      </div>

      <div class="featured__topics">
        <p>{t.featured.askAbout}</p>
        <ul>
          {
            t.featured.topics.map((topic) => (
              <li>
                <Icon name="check" size={18} />
                {topic}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="featured__actions">
        {selling && isAvailable(product) && <AddToCart product={product} locale={locale} />}
        <a
          class="btn btn--dark magnetic"
          href={quotePath(locale, product.slug, 'informacoes')}
          data-quote-product={product.slug}
          data-quote-type="informacoes"
        >
          {t.featured.cta}
          <Icon name="arrow-right" />
        </a>
        <a class="text-link" href={productPath(locale, product.slug)}>{t.featured.detailsLink}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding-top: 0;
  }

  .featured__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 1.5rem + 3vw, 5rem);
    align-items: center;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 3.5rem);
    border-radius: calc(var(--radius-lg) + 8px);
    background:
      radial-gradient(70% 80% at 0% 100%, rgb(62 102 80 / 0.14), transparent 70%),
      var(--sage);
  }

  .featured__media {
    width: 100%;
    max-width: 420px;
    justify-self: center;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-lg);
  }

  .featured__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
  }

  .featured__content {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .featured__content h2 {
    font-size: var(--step-3);
  }

  .featured__lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .featured__product {
    display: grid;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius);
    background: var(--glass);
    border: 1px solid rgb(62 102 80 / 0.15);
  }

  .featured__product h3 {
    font-size: 1.35rem;
  }

  .featured__product p {
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .featured__topics {
    display: grid;
    gap: 0.6rem;
  }

  .featured__topics > p {
    font-weight: 700;
  }

  .featured__topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .featured__topics li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem 0.4rem 0.6rem;
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .featured__topics li :global(svg) {
    color: var(--sage-ink);
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: 0.3rem;
  }

  @media (max-width: 899px) {
    .featured__panel {
      grid-template-columns: 1fr;
    }

    .featured__media {
      max-width: 520px;
      width: 100%;
      justify-self: center;
    }
  }
</style>
