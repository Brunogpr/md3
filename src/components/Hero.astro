---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import DragonRig from './DragonRig.astro';
import { getDictionary, homePath, productsPath, type Locale } from '../i18n';
import { sectionIds, siteConfig } from '../config/site';
import { categories } from '../data/categories';
import nozzle from '../assets/brand/banner/bico.png';
import letterM from '../assets/brand/banner/letra-m.png';
import wordmark from '../assets/brand/banner/wordmark.png';
import slogan from '../assets/brand/banner/slogan.png';
import fullLogo from '../assets/brand/logo-moldea.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

// O dragão separado é opcional: sem ele, o banner mostra a logo completa (com o dragão original).
const dragonModules = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/banner/dragao.png', { eager: true });
const dragon = Object.values(dragonModules)[0]?.default;
const animated = siteConfig.bannerDragon === 'animado';

// Todas as camadas têm a mesma tela (1254x1254) e sobrepõem-se exatamente.
const layer = { width: 720, densities: [1, 2] as number[], alt: '' };
---

<section class="hero" id={sectionIds.home} aria-labelledby="hero-title" data-hero>
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__grid-bg" aria-hidden="true"></div>

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="split-words">{t.hero.titleLead}</span>
        <span class="hero__accent split-words">{t.hero.titleAccent}</span>
      </h1>
      <p class="hero__subtitle">{t.hero.subtitle}</p>
      <div class="hero__actions">
        <a class="btn btn--primary magnetic" href={productsPath(locale)}>
          {t.hero.primaryCta}
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--outline magnetic" href={homePath(locale, sectionIds.customization)}>
          {t.hero.secondaryCta}
        </a>
      </div>
    </div>

    <div class="hero__stage-wrap">
      {
        animated || dragon ? (
          <div class="stage" data-banner role="img" aria-label={t.banner.alt}>
            <div class="stage__layer" data-depth="10">
              <Image src={nozzle} {...layer} class="stage__nozzle" loading="eager" />
            </div>
            <div class="stage__layer" data-depth="5">
              <div class="stage__print">
                <Image src={letterM} {...layer} loading="eager" fetchpriority="high" />
              </div>
            </div>
            {!animated && dragon && (
              <div class="stage__layer stage__layer--dragon" data-depth="5">
                <div class="stage__dragon-box" data-dragon>
                  <Image src={dragon} width={420} densities={[1, 2]} alt="" class="stage__dragon" loading="eager" />
                </div>
              </div>
            )}
            <div class="stage__layer" data-depth="3">
              <div class="stage__wordmark">
                <Image src={wordmark} {...layer} loading="eager" />
              </div>
            </div>
            <div class="stage__layer" data-depth="2">
              <div class="stage__slogan">
                <Image src={slogan} {...layer} loading="eager" />
              </div>
            </div>
            {animated && (
              <div class="walker" data-walker data-facing="left">
                <DragonRig />
              </div>
            )}
          </div>
        ) : (
          <div class="stage stage--static" role="img" aria-label={t.banner.alt}>
            <Image src={fullLogo} width={720} densities={[1, 2]} alt="" loading="eager" fetchpriority="high" />
          </div>
        )
      }
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {
        [0, 1].map(() => (
          <ul>
            {categories.map((c) => (
              <li>{c.label[locale]}</li>
            ))}
            <li>{t.hero.eyebrow}</li>
            <li>Creamos ideas en 3D</li>
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
  import '../scripts/dragon-walk';
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    isolation: isolate;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(45% 50% at 78% 38%, rgb(1 163 234 / 0.16), transparent 70%),
      radial-gradient(40% 45% at 62% 70%, rgb(255 163 13 / 0.16), transparent 70%);
  }

  /* Grelha fina, como a base de impressão. */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 60% 40%, #000 20%, transparent 75%);
    opacity: 0.55;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    min-height: min(78vh, 760px);
  }

  .hero__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .hero__title {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .hero__title > span {
    display: block;
  }

  .hero__accent {
    background: linear-gradient(95deg, var(--orange-deep) 0%, var(--orange) 55%, #ffc23a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  /* Palavras animadas: o gradiente aplica-se a cada palavra para não se perder. */
  .hero__accent :global(.word__inner) {
    background: inherit;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero__subtitle {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.4rem;
  }

  /* ---------- Palco da logo ---------- */
  .hero__stage-wrap {
    justify-self: center;
    width: min(100%, 600px);
  }

  .stage {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    --mx: 0;
    --my: 0;
  }

  .stage--static :global(img) {
    width: 100%;
    height: auto;
    animation: float 6s ease-in-out infinite;
  }

  .stage__layer {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--mx) * var(--d, 0) * 1px), calc(var(--my) * var(--d, 0) * 1px), 0);
    transition: transform 0.25s ease-out;
    pointer-events: none;
  }

  .stage__layer[data-depth='2'] { --d: 2; }
  .stage__layer[data-depth='3'] { --d: 3; }
  .stage__layer[data-depth='5'] { --d: 5; }
  .stage__layer[data-depth='10'] { --d: 10; }

  .stage__layer :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage__print,
  .stage__wordmark,
  .stage__slogan {
    position: absolute;
    inset: 0;
  }

  /* Camadas da logo à frente; o dragão fica por trás do M (como na logo) e só passa à frente
     quando salta por cima da letra. */
  .stage__layer {
    z-index: 2;
  }

  .stage__layer--dragon {
    z-index: 1;
  }

  /* Caixa do dragão: posição medida na logo (707–1195 x 169–875 em 1254 px). Inclina-se
     ligeiramente na direção do rato, a partir dos pés. */
  .stage__dragon-box {
    position: absolute;
    left: var(--dragon-left, 56.4%);
    top: var(--dragon-top, 13.5%);
    width: var(--dragon-width, 38.9%);
    transform-origin: 50% 100%;
    rotate: calc(var(--mx, 0) * 4deg);
    transition: rotate 0.6s var(--ease);
    pointer-events: auto;
    cursor: pointer;
  }

  .stage__dragon-box :global(.stage__dragon) {
    position: static;
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
  }

  /* Dragão animado: anda por cima das letras "MOLDEA" (o chão fica a 70,5% da tela). */
  .walker {
    position: absolute;
    z-index: 4;
    left: 68%;
    bottom: 29%;
    width: 28%;
    cursor: pointer;
    pointer-events: auto;
  }

  .walker[data-facing='right'] :global(.rig) {
    scale: -1 1;
  }

  /* Com JS e movimento: começa fora do palco e entra a andar. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .walker:not(.is-on) {
      opacity: 0;
    }
  }

  /* ---------- Sequência de entrada (só com JS e sem "reduzir movimento") ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stage[data-banner]:not(.is-ready) :global(img) {
      opacity: 0;
    }

    .stage.is-ready :global(.stage__nozzle) {
      animation:
        nozzle-in 0.7s var(--ease) both,
        nozzle-print 0.45s 0.7s ease-in-out 4 alternate;
    }

    .stage.is-ready .stage__print {
      animation: print-up 1.8s 0.6s steps(26, end) both;
    }

    .stage.is-ready .stage__wordmark {
      animation: wipe-in 0.9s 2.3s var(--ease) both;
    }

    .stage.is-ready .stage__slogan {
      animation: rise 0.8s 2.9s var(--ease) both;
    }

    .stage.is-ready :global(.stage__dragon) {
      animation:
        dragon-enter 1.1s 3.1s var(--ease) both,
        dragon-life 11s 4.6s ease-in-out infinite,
        breathe 2.8s 4.2s ease-in-out infinite;
    }

    /* Na caixa (não na imagem), para somar ao ciclo sem o reiniciar. */
    .stage.is-ready .stage__dragon-box.is-happy {
      animation: dragon-happy 0.9s ease-in-out;
    }
  }

  @keyframes nozzle-in {
    from { transform: translateY(-35%); opacity: 0; }
  }

  @keyframes nozzle-print {
    from { transform: translateX(-1.5%); }
    to { transform: translateX(1.5%); }
  }

  /* Impressão camada a camada, de baixo para cima. */
  @keyframes print-up {
    /* A base do M está a ~71% da tela; o topo do filamento a ~23%. */
    from { clip-path: inset(71% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes wipe-in {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
  }

  @keyframes float {
    50% { transform: translateY(-10px); }
  }

  /* Sobe por trás do M e espreita (com um pequeno ressalto). */
  @keyframes dragon-enter {
    0% { opacity: 0; transform: translateY(45%); }
    60% { opacity: 1; transform: translateY(-6%) scale(0.97, 1.04); }
    80% { transform: translateY(1%) scale(1.03, 0.97); }
    100% { opacity: 1; transform: none; }
  }

  /* Ciclo "de animal", sempre do lado direito do M (a origem é nos pés):
     olha em volta → agacha-se e esconde-se atrás do M → espreita de novo →
     salta no lugar (compressão antes e ao aterrar) → inclina-se. */
  @keyframes dragon-life {
    0%, 8% { transform: none; }
    12%, 18% { transform: rotate(-5deg); }
    23% { transform: rotate(2deg); }
    27% { transform: none; }
    31% { transform: translateY(3%) scale(1.04, 0.94); }
    35%, 43% { transform: translateY(24%) scale(0.99, 1.01); }
    47% { transform: translateY(-5%) scale(0.96, 1.06); }
    50% { transform: translateY(1%) scale(1.04, 0.95); }
    53% { transform: none; }
    62% { transform: translateY(2%) scale(1.06, 0.92); }
    66% { transform: translateY(-13%) scale(0.95, 1.07) rotate(-2deg); }
    69% { transform: translateY(-15%) rotate(2deg); }
    73% { transform: translateY(1%) scale(1.07, 0.92); }
    76% { transform: scale(0.98, 1.03); }
    79% { transform: none; }
    87%, 91% { transform: rotate(4deg); }
    96%, 100% { transform: none; }
  }

  /* Ao clicar: saltinho rápido e abanar. */
  @keyframes dragon-happy {
    0% { transform: none; }
    20% { transform: translateY(2%) scale(1.06, 0.92); }
    45% { transform: translateY(-12%) scale(0.95, 1.07) rotate(-6deg); }
    65% { transform: translateY(0) rotate(5deg) scale(1.05, 0.94); }
    80% { transform: rotate(-3deg); }
    100% { transform: none; }
  }

  @keyframes breathe {
    50% { scale: 1.01 1.03; }
  }

  /* ---------- Faixa contínua de palavras ---------- */
  .marquee {
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    padding-block: 1rem;
    border-block: 1px solid var(--line);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 32s linear infinite;
  }

  .marquee ul {
    display: flex;
    list-style: none;
  }

  .marquee li {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink-soft);
  }

  .marquee li::after {
    content: '';
    width: 0.6em;
    height: 0.6em;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--orange), var(--blue));
    transform: rotate(45deg);
  }

  @keyframes marquee {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }

  @media (max-width: 1023px) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__stage-wrap {
      order: -1;
      width: min(100%, 440px);
    }

    .hero__copy {
      justify-items: center;
      text-align: center;
    }

    .hero__subtitle {
      margin-inline: auto;
    }

    .hero__actions {
      justify-content: center;
    }
  }

  @media (max-width: 479px) {
    .hero__actions {
      flex-direction: column;
      align-self: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
