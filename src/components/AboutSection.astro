---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-moldea.png';
import { getDictionary, type Locale } from '../i18n';
import { sectionIds, siteConfig } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="section about" id={sectionIds.about} aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__brand reveal">
      <Image src={logo} alt={`${siteConfig.brandName} — ${siteConfig.slogan}`} width={460} densities={[1, 2]} loading="lazy" />
    </div>
    <div class="about__content reveal">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 id="about-title" class="split-words">{t.about.title}</h2>
      {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg-sand);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1.5rem + 4vw, 6rem);
  }

  .about__brand {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-radius: calc(var(--radius-lg) + 8px);
    background: var(--bg);
    box-shadow: var(--shadow);
  }

  .about__brand img {
    width: min(100%, 420px);
    height: auto;
  }

  .about__content {
    display: grid;
    gap: 1.15rem;
  }

  .about__content h2 {
    font-size: var(--step-3);
    margin-bottom: 0.25rem;
  }

  .about__content p:not(.eyebrow) {
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 36rem;
  }

  @media (max-width: 899px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__brand {
      order: 2;
    }
  }
</style>
